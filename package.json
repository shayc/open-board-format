{
  "name": "@shayc/open-board-format",
  "version": "1.3.5",
  "description": "Parse, validate, and create Open Board Format (.obf/.obz) files — the open standard for Augmentative and Alternative Communication (AAC) boards. TypeScript, browser and Node.js.",
  "license": "MIT",
  "author": "Shay Cojocaru <shayc@outlook.com>",
  "homepage": "https://github.com/shayc/open-board-format#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayc/open-board-format.git"
  },
  "bugs": {
    "url": "https://github.com/shayc/open-board-format/issues"
  },
  "keywords": [
    "assistive-technology",
    "augmentative-alternative-communication",
    "communication-board",
    "open-board-format"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/external/open-board-format.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
